---
import { getPathname, getTranslations, getCollectionByLocale } from '@lib/i18n';
import { Image } from 'astro:assets';

const t = getTranslations('Ventures');

const ventures = await getCollectionByLocale('ventures');
const pages = ventures
  .filter(({ entry }) => !entry.data.draft)
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());
---

<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
  <div class="col-span-full text-lg font-medium">{t('title')}</div>

  {pages.map(({ entry: page, slug }) => (
    <a class="group flex flex-col gap-3" href={getPathname(slug)}>
      <div class="relative aspect-video overflow-hidden rounded-lg bg-muted after:absolute after:inset-0 after:rounded-lg after:border after:border-border">
        {page.data.image && (
          <Image
            alt={page.data.title}
            class="size-full dark:invert"
            height={900}
            loading="eager"
            src={page.data.image}
            width={1600}
          />
        )}
      </div>

      <div class="flex flex-col gap-1 text-sm">
        <h2 class="line-clamp-1 decoration-1 underline-offset-4 group-hover:text-accent group-hover:underline">
          {page.data.title}
        </h2>

        <p class="line-clamp-2 text-muted-foreground">{page.data.description}</p>
      </div>
    </a>
  ))}
</div>
