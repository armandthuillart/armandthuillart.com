---
import { Image } from "astro:assets";
import { getPathname, getTranslations, getCollectionByLocale } from "@lib/i18n";

const t = getTranslations("Ventures");

const pages = (await getCollectionByLocale("ventures"))
    .filter(({ entry }) => !entry.data.draft)
    .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());
---

<div class="grid gap-5 grid-cols-1 sm:grid-cols-2">
    <div class="text-lg font-medium col-span-full">{t("title")}</div>

    {pages.map(({ entry: page, slug }) => (
        <a class="group flex flex-col gap-3" href={getPathname(slug)}>
            <div class="aspect-video relative after:absolute after:inset-0 after:border after:rounded-lg after:border-border bg-muted rounded-lg overflow-hidden">
                {page.data.image && (
                    <Image
                        alt={page.data.title}
                        class="size-full dark:invert"
                        height={900}
                        loading="eager"
                        src={page.data.image}
                        width={1600}
                    />
                )}
            </div>

            <div class="flex flex-col text-sm gap-1">
                <h2 class="line-clamp-1 group-hover:text-accent group-hover:underline decoration-1 underline-offset-4">{page.data.title}</h2>

                <p class="text-muted-foreground line-clamp-2">
                    {page.data.description}
                </p>
            </div>
        </a>
    ))}
</div>
