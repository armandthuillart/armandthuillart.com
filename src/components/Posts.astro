---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="mt-3 flex flex-col">
  <h2 class="text-muted-foreground">{title}</h2>
  <div class="flex flex-col transition-opacity duration-200 ease-[ease] md:[&:has(a:hover)>a:not(:hover)]:opacity-40"></div>
</section>
