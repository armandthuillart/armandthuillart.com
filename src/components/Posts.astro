---
import { getLocale, getPathname, getCollectionByLocale } from "@lib/i18n";

interface Props {
    count: number;
    label: string;
}

const { count, label } = Astro.props;

const posts = (await getCollectionByLocale("blog"))
    .filter(({ entry }) => !entry.data.draft)
    .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf())
    .slice(0, count);
---

<div class="grid gap-5">
    <h1 class="text-lg font-medium">{label}</h1>

    <div class="grid">
        {posts.map(({ entry: post, slug }) => (
            <a
                class="group not-last:border-b border-border py-4 flex justify-between gap-4"
                href={getPathname(`blog/${slug}`)}
            >
                <h2 class="group-hover:text-accent group-hover:underline decoration-1 underline-offset-4 line-clamp-1 text-sm min-w-0">
                    {post.data.title}
                </h2>

                <p class="text-sm text-muted-foreground shrink-0">
                    {post.data.date.toLocaleDateString(getLocale(), {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                    })}
                </p>
            </a>
        ))}
    </div>
</div>
