---
import { getLocale, getPathname, getCollectionByLocale } from '@lib/i18n';

interface Props {
  count: number;
  label: string;
}

const { count, label } = Astro.props;

const collection = await getCollectionByLocale('blog');
const posts = collection
  .filter(({ entry }) => !entry.data.draft)
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf())
  .slice(0, count);
---

<div class="grid gap-5">
  <h1 class="text-lg font-medium">{label}</h1>

  <div class="grid">
    {posts.map(({ entry: post, slug }) => (
      <a
        class="group flex justify-between gap-4 border-border py-4 not-last:border-b"
        href={getPathname(`blog/${slug}`)}
      >
        <h2 class="line-clamp-1 min-w-0 text-sm decoration-1 underline-offset-4 group-hover:text-accent group-hover:underline">
          {post.data.title}
        </h2>

        <p class="shrink-0 text-sm text-muted-foreground">
          {post.data.date.toLocaleDateString(getLocale(), {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
        </p>
      </a>
    ))}
  </div>
</div>
