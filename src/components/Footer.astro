---
import Sprite from '@components/Sprite.astro';
---

<div class="flex items-center justify-self-end **:dark:text-white">
  <a
    class="flex size-7 items-center justify-center hover:opacity-80"
    href="https://www.linkedin.com/in/armandthuillart"
    rel="noopener noreferrer"
    target="_blank"
  >
    <span class="sr-only">LinkedIn</span>
    <Sprite className="size-4 text-[#0A66C2]" symbol="linkedin" />
  </a>

  <a
    class="flex size-7 items-center justify-center hover:opacity-80"
    href="https://www.github.com/armandthuillart"
    rel="noopener noreferrer"
    target="_blank"
  >
    <span class="sr-only">GitHub</span>
    <Sprite className="size-4 text-black" symbol="github" />
  </a>
</div>
