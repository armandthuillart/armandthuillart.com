---
import armand from '@assets/armand.webp';
import Tab from '@components/Tab.astro';
import { getLocale, getPathname, getTranslations, locales, type Locale } from '@lib/i18n';
import type { HTMLTag } from 'astro/types';
import { Image } from 'astro:assets';

const locale = getLocale();
const names: Record<Locale, string> = {
  en: 'English',
  fr: 'Français',
};
const t = getTranslations('Header');
const home = getPathname();

const isCollapsed = Astro.url.pathname !== home;
const path = Astro.url.pathname.replace(/^\/(en|fr)(?=\/|$)/, '');
const AvatarTag: HTMLTag = isCollapsed ? 'a' : 'div';
const NameTag: HTMLTag = isCollapsed ? 'a' : 'div';
---

<div
  class:list={[
    'grid-cols-[auto_1fr] gap-4 min-[23.4375rem]:grid',
    !isCollapsed ? 'flex flex-col lg:pt-24' : 'grid',
  ]}
>
  <AvatarTag class="h-min rounded-full" href={isCollapsed ? home : undefined}>
    <Image
      alt={t('portrait')}
      class:list={['rounded-full', isCollapsed ? 'size-8' : 'size-32']}
      loading="eager"
      src={armand}
    />
  </AvatarTag>

  <div
    class:list={[
      'items-start gap-4 min-[21.875rem]:grid min-[21.875rem]:items-center',
      isCollapsed ? 'grid-cols-[1fr_auto_auto]' : 'flex grid-cols-[1fr_auto] flex-col',
    ]}
  >
    <NameTag
      class:list={[
        'col-start-1 row-start-1 font-medium [text-box-edge:cap_alphabetic] [text-box-trim:both]',
        isCollapsed ? 'self-center text-xl' : 'text-3xl',
      ]}
      href={isCollapsed ? home : undefined}
    >
      Armand Thuillart
    </NameTag>

    <select
      aria-label={t('language')}
      name="locale"
      class:list={[
        'row-start-1 cursor-pointer justify-self-end text-sm text-accent decoration-1 underline-offset-4 hover:underline',
        isCollapsed ? 'col-start-3' : 'col-start-2',
      ]}
      onchange="location.href = this.value"
    >
      {locales.map((code) => (
        <option selected={code === locale} value={getPathname(path, code)}>
          {names[code]}
        </option>
      ))}
    </select>

    {!isCollapsed && (
      <p
        class="col-span-full [&_a]:text-accent [&_a]:underline [&_a]:decoration-1 [&_a]:underline-offset-4"
        set:html={t.rich('bio', {
          crosspost: (chunks) => `<a href="${getPathname('crosspost')}">${chunks}</a>`,
          dimsight: (chunks) =>
            `<a href="https://dimsight.com" target="_blank" rel="noopener noreferrer">${chunks}</a>`,
        })}
      />
    )}

    <div
      class:list={[
        'hidden items-center gap-2 min-[28.125rem]:flex',
        isCollapsed ? 'col-start-2 row-start-1' : 'col-span-full',
      ]}
    >
      <Tab href={home} text={t('about')} />
      <Tab href={getPathname('blog')} text={t('blog')} />
    </div>
  </div>
</div>
