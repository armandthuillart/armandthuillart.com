---
import { Image } from "astro:assets";
import armand from "@assets/armand.webp";
import Tab from "@components/Tab.astro";
import {
    getLocale,
    getPathname,
    getTranslations,
    locales,
    type Locale,
} from "@lib/i18n";
import type { HTMLTag } from "astro/types";

const locale = getLocale();
const names: Record<Locale, string> = { en: "English", fr: "Français" };
const t = getTranslations("Header");
const home = getPathname();

const isCollapsed = Astro.url.pathname !== home;
const path = Astro.url.pathname.replace(/^\/(en|fr)(?=\/|$)/, "");
const AvatarTag: HTMLTag = isCollapsed ? "a" : "div";
const NameTag: HTMLTag = isCollapsed ? "a" : "div";
---

<div
    class:list={[
        "min-[23.4375rem]:grid grid-cols-[auto_1fr] gap-4",
        !isCollapsed ? "lg:pt-24 flex flex-col" : "grid",
    ]}
>
    <AvatarTag class="rounded-full h-min" href={isCollapsed ? home : undefined}>
        <Image
            alt={t("portrait")}
            class:list={["rounded-full", isCollapsed ? "size-8" : "size-32"]}
            loading="eager"
            src={armand}
        />
    </AvatarTag>

    <div
        class:list={[
            "items-start min-[21.875rem]:grid gap-4 min-[21.875rem]:items-center",
            isCollapsed
                ? "grid-cols-[1fr_auto_auto]"
                : "flex flex-col grid-cols-[1fr_auto]",
        ]}
    >
        <NameTag
            class:list={[
                "col-start-1 row-start-1 font-medium [text-box-edge:cap_alphabetic] [text-box-trim:both]",
                isCollapsed ? "text-xl self-center" : "text-3xl",
            ]}
            href={isCollapsed ? home : undefined}
        >
            Armand Thuillart
        </NameTag>

        <select
            aria-label={t("language")}
            name="locale"
            class:list={[
                "row-start-1 justify-self-end text-sm text-accent hover:underline underline-offset-4 decoration-1 cursor-pointer",
                isCollapsed ? "col-start-3" : "col-start-2",
            ]}
            onchange="location.href = this.value"
        >
            {locales.map((code) => (
                <option
                    selected={code === locale}
                    value={getPathname(path, code)}
                >
                    {names[code]}
                </option>
            ))}
        </select>

        {!isCollapsed && (
            <p
                class="col-span-full [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-1"
                set:html={t.rich("bio", {
                    crosspost: (chunks) =>
                        `<a href="${getPathname("crosspost")}">${chunks}</a>`,
                    dimsight: (chunks) =>
                        `<a href="https://dimsight.com" target="_blank" rel="noopener noreferrer">${chunks}</a>`,
                })}
            />
        )}

        <div
            class:list={[
                "hidden min-[28.125rem]:flex gap-2 items-center",
                isCollapsed ? "col-start-2 row-start-1" : "col-span-full",
            ]}
        >
            <Tab href={home} text={t("about")} />
            <Tab href={getPathname("blog")} text={t("blog")} />
        </div>
    </div>
</div>
