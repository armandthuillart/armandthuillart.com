---
interface Props {
    href: string;
    text: string;
}

const { href, text } = Astro.props;

const isActive = href === Astro.url.pathname;
---

<a
    class:list={[
        "text-sm py-1 font-medium rounded-full px-2",
        isActive && "bg-accent text-white",
    ]}
    href={href}
>
    {text}
</a>
