---
import '@styles/global.css';
import Footer from '@components/Footer.astro';
import Head from '@components/Head.astro';
import Header from '@components/Header.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang={Astro.currentLocale ?? 'en'} class="px-4 antialiased scheme-light-dark">
  <head>
    <Head title={title} />
  </head>

  <body class="container mx-auto max-w-160 bg-background text-foreground">
    <main class="grid gap-12 py-12">
      <header>
        <Header />
      </header>

      <slot />

      <footer class="grid">
        <Footer />
      </footer>
    </main>
  </body>
</html>
