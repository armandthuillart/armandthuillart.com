---
import "@styles/global.css";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

type Props = { title: string };

const { title } = Astro.props;
---

<html
    lang={Astro.currentLocale ?? "en"}
    class="px-4 antialiased scheme-light-dark"
>
    <head>
        <Head title={title} />
    </head>

    <body class="bg-background text-foreground mx-auto container max-w-160">
        <main class="grid gap-12 py-12">
            <header>
                <Header />
            </header>

            <slot />

            <footer class="grid">
                <Footer />
            </footer>
        </main>
    </body>
</html>
