{
  "languages": {
    "Astro": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "language_servers": ["oxfmt", "tailwindcss-intellisense-css"]
    },
    "HTML": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "MDX": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "TypeScript": {
      "code_actions_on_format": { "source.fixAll.oxc": true },
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "YAML": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    }
  },
  "lsp": {
    "oxfmt": {
      "binary": {
        "arguments": ["fmt", "--lsp"],
        "path": "node_modules/.bin/vp"
      },
      "initialization_options": {
        "settings": {
          "fmt.configPath": "./vite.config.ts"
        }
      }
    },
    "oxlint": {
      "binary": {
        "arguments": ["lint", "--lsp"],
        "path": "node_modules/.bin/vp"
      },
      "initialization_options": {
        "settings": {
          "fixKind": "safe_fix",
          "typeAware": false, // Avoid per-keystroke tsgolint lag in Zed (see https://github.com/oxc-project/oxc-intellij-plugin/issues/366#issuecomment-4952770299)
          "unusedDisableDirectives": "deny"
        }
      }
    }
  }
}
